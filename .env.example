# Telegram user-аккаунт (для чтения групповых чатов через Telethon)
TG_API_ID=123456
TG_API_HASH=your_api_hash_here
TG_SESSION_NAME=triage_userbot

# Settings-бот — команды и настройка (/chats, /find, /tag, /profile,
# /add_rule, /rules, /go). Обычный бот через BotFather.
TG_BOT_TOKEN=123456:your_settings_bot_token_here

# Alert-бот — ОТДЕЛЬНЫЙ бот, только шлёт уведомления о важных сообщениях.
# Тоже обычный бот через BotFather (создать ВТОРОГО бота, не путать с TG_BOT_TOKEN).
# После первого запуска нужно один раз написать /start этому боту — так
# программа узнает, куда слать уведомления.
TG_ALERT_BOT_TOKEN=123456:your_alert_bot_token_here

# Кому разрешено пользоваться обоими ботами — telegram user_id через запятую
# БЕЗ пробелов (свой user_id можно узнать, например, у @userinfobot).
# Сюда же — id того, кто будет пользоваться ботом по факту (например, твоей
# девушки): данные (чаты/теги/правила/профиль) общие для всех из списка,
# это не отдельные копии на человека.
# Если оставить пустым — боты отвечают всем подряд (не рекомендуется).
ALLOWED_TG_USER_IDS=111111111,222222222

# Часовой пояс для отображения времени сообщений в уведомлениях.
# Список названий: https://en.wikipedia.org/wiki/List_of_tz_database_time_zones
# (час дневной сводки настраивается отдельно, командой /settings в боте)
TIMEZONE=Europe/Moscow

# БД
DATABASE_URL=sqlite+aiosqlite:///./triage.db

# ИИ для классификации (Gemini, ключ(и) из Google AI Studio).
# Можно указать несколько через запятую БЕЗ пробелов — программа будет
# крутить их по кругу и переключаться на следующий, если у текущего
# закончилась квота: GEMINI_API_KEY=ключ1,ключ2,ключ3
GEMINI_API_KEY=your_gemini_key_here
